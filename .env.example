# Required application authentication.
CHATGPT2API_AUTH_KEY=replace-with-a-long-random-value

# Optional public URL used for generated image links.
# CHATGPT2API_BASE_URL=https://example.invalid

# Optional storage backend: json, sqlite, postgres, or git.
STORAGE_BACKEND=json

# Optional published image. The default builds locally.
# CHATGPT2API_IMAGE=ghcr.io/organization/chatgpt2api:latest

# Optional database settings.
# DATABASE_URL=postgresql://db-user:db-password@db-host:5432/chatgpt2api
# DATABASE_URL=sqlite:///app/data/accounts.db

# Optional private Git storage settings.
# GIT_REPO_URL=https://example.invalid/private-repository.git
# GIT_TOKEN=replace-with-a-secret
# GIT_BRANCH=main
# GIT_FILE_PATH=accounts.json

# Optional WARP / FlareSolverr settings.
# CHATGPT2API_PORT=3000
# WARP_SOCKS_PORT=40000
# PRIVOXY_PORT=40080
# FLARESOLVERR_PORT=8191
# FLARESOLVERR_LOG_LEVEL=info
# TZ=UTC
# WARP_LICENSE_KEY=
# CHATGPT2API_PROXY_RUNTIME_ENABLED=true
# CHATGPT2API_PROXY_RUNTIME_EGRESS_MODE=single_proxy
# CHATGPT2API_PROXY_RUNTIME_PROXY_URL=http://privoxy:8118
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_ENABLED=true
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_MODE=flaresolverr
# CHATGPT2API_FLARESOLVERR_URL=http://flaresolverr:8191
